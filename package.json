{
  "name": "jscad-scad-api",
  "version": "3.0.5",
  "description": "JSCAD bridge for OpenSCAD designs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jscad-community/jscad-scad-api.git"
  },
  "type": "module",
  "main": "src/index.js",
  "unpkg": "dist/jscad-scad-api.js",
  "jsdelivr": "dist/jscad-scad-api.js",
  "scripts": {
    "build": "rollup --config",
    "coverage": "c8 --all --reporter=html --reporter=text npm run tests",
    "tests": "ava 'tests/*.test.js' --verbose --timeout 2m",
    "lint": "standardx './**/*.js'",
    "docs": "jsdoc2md --files 'src/*.js' | grep -v 'a name' > README.md"
  },
  "keywords": [
    "openscad",
    "bridge",
    "api",
    "jscad"
  ],
  "license": "MIT",
  "dependencies": {
    "@jscad/modeling": "3.0.4-alpha.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "ava": "^6.3.0",
    "c8": "^10.1.0",
    "jsdoc-to-markdown": "^9.1.3",
    "rollup": "^4.52.2",
    "standardx": "^7.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "standardx": {
    "ignore": [
      "**/dist/"
    ],
    "env": {
      "browser": true,
      "node": true
    }
  },
  "eslintConfig": {
    "rules": {
      "camelcase": "off",
      "func-style": [
        "error",
        "expression"
      ],
      "arrow-body-style": [
        "error",
        "as-needed"
      ],
      "arrow-parens": [
        "error",
        "always"
      ],
      "arrow-spacing": "error",
      "prefer-arrow-callback": "error",
      "no-var": "error"
    }
  }
}
