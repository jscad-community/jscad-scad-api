{
  "name": "jscad-scad-api",
  "version": "3.0.6",
  "description": "JSCAD bridge for OpenSCAD designs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jscad-community/jscad-scad-api.git"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    "node": "./src/index.js",
    "default": "./dist/jscad-scad-api.js"
  },
  "scripts": {
    "build": "rollup --config",
    "coverage": "c8 --all --reporter=html --reporter=text npm run tests",
    "tests": "ava 'tests/*.test.js' --verbose --timeout 2m",
    "lint": "npx eslint",
    "docs": "jsdoc2md --files 'src/*.js' | grep -v 'a name' > README.md"
  },
  "keywords": [
    "openscad",
    "bridge",
    "library",
    "api",
    "jscad"
  ],
  "license": "MIT",
  "dependencies": {
    "@jscad/modeling": "3.0.7-alpha.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "ava": "^6.3.0",
    "c8": "^10.1.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jsdoc-to-markdown": "^9.1.3",
    "rollup": "^4.52.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
